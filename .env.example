# URL to probe for internet reachability (HEAD request).
PING_TARGET_URL=https://1.1.1.1

# How often to check, in milliseconds.
CHECK_INTERVAL_MS=300000

# Max time to wait for a single reachability check, in milliseconds.
CHECK_TIMEOUT_MS=5000

# Discord webhook URL used to push up/down/boot alerts. Keep secret.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Directory where daily status log files are written.
LOG_DIR=./logs
